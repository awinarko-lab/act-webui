# Port and bind host. Local-first: loopback by default (KTD9).
# Set HOST=0.0.0.0 ONLY behind auth on a shared server — the run API is
# unauthenticated and can execute arbitrary workflow code via act.
PORT=3000
HOST=127.0.0.1

# Repository to run act against (defaults to the server's working directory).
ACT_REPO_PATH=

# SQLite database location (defaults to ./data/act-web-ui.sqlite).
# Kept out of git (.gitignore) because persisted logs may contain secret values.
DB_PATH=

# How many recent runs to retain per repo (keep-last-N pruning). Default 50.
HISTORY_LIMIT=50

# Allowed browser origin for the run API + Socket.io
# (defaults to http://$HOST:$PORT).
ALLOWED_ORIGIN=
